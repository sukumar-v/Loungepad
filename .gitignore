# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
*.binlog

# Publish / packaging
[Pp]ublish/
*.publishsettings
*.pubxml.user
*.appx
*.appxbundle
*.msix
*.msixbundle

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# Visual Studio / Rider / VS Code user state
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
.vscode/*
!.vscode/extensions.json

# Claude Code local settings (launch.json is shared project config and IS tracked)
.claude/settings.local.json

# Test / coverage results
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml

# ReSharper / dotCover
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# OS cruft
[Tt]humbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor backups
*.swp
*~

# Loungepad runtime data (lives in %APPDATA%\Loungepad, but never commit strays)
/settings.json
/library.json
/loungepad.log
/covers/

# Packaging output
dist/

# Wrangler's local state for the metadata proxy (build output, dev cache)
.wrangler/

# The trailer project: a Remotion app, its node_modules, the screen recordings, the music and
# the rendered video. Large, and only needed to remake the trailer, the README screenshots and
# the header lockup, so it stays out of the repository.
/trailer/

# Video never belongs in the repository: a clone would carry it forever.
*.mp4
*.mkv
*.mov

# Wrangler's local secrets file for the metadata proxy: never committed.
.dev.vars
.dev.vars.*
