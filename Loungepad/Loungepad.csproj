<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon only (TrayIcon.cs); WPF has no tray icon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Loungepad</AssemblyName>
    <RootNamespace>Loungepad</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Loungepad.ico</ApplicationIcon>
    <Version>1.6.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms would import these everywhere, and half their names (Application,
         MessageBox, Point, Color) are WPF's too. TrayIcon imports what it uses. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
    <!-- DPAPI, for the store sign-in tokens kept under %APPDATA%\Loungepad\accounts. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Reads Playnite's library for the import (Services/PlayniteImport.cs). 5.x, not the 4.1.4 Playnite
         itself uses: 4.x carries a critical advisory, and 5 reads v4 files by upgrading a copy. -->
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Themes that ship with the app. Copied next to the exe, then seeded into the user's
         themes folder on first run so they are discoverable without hunting for AppData. -->
    <None Include="themes\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Vortex extension that answers the Mods screen. Copied next to the exe, then into
         Vortex's own plugins folder by VortexBackend.SyncPlugin, keyed on its info.json version. -->
    <None Include="vortex-bridge\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- ApplicationIcon gives the exe its icon; Resource also embeds it so the window itself
         (and therefore Alt-Tab) can use it, since there is no taskbar button to carry one -->
    <Resource Include="Loungepad.ico" />
  </ItemGroup>

</Project>
