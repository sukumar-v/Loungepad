<Window x:Class="Loungepad.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loungepad Keyboard"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        Background="Transparent">
    <!--
      AllowsTransparency is safe here, unlike on MainWindow: the trouble it causes is that WPF
      hosts a layered window and a hosted WebView2 then receives no mouse or wheel messages. There
      is no WebView2 in here, and the keyboard is driven entirely by the gamepad, so it never needs
      a mouse message at all. What it buys is real rounded corners over a game.

      The keys themselves are built in code from the layout tables (KeyboardLayout): the layout is
      data, and placing keys on a canvas by column is less machinery than binding blocks of
      ragged-width, sometimes two-row-tall keys. The suggestion bar is the board's first row.
    -->
    <Border x:Name="Root" Background="#F2141417" CornerRadius="18" Padding="18"
            BorderBrush="#33FFFFFF" BorderThickness="1" UseLayoutRounding="True">
        <StackPanel>
            <!-- Grab bar. The keyboard parks near the bottom of the TV, which is exactly where a
                 game's chat box tends to be, so it has to be movable off whatever it covers. The
                 fill is faint rather than absent so the strip reads as something you can grab. -->
            <Border x:Name="Grip" Background="#14FFFFFF" Cursor="SizeAll" CornerRadius="10">
                <Grid>
                    <TextBlock x:Name="GripTitle" Text="Loungepad Keyboard" Foreground="#8AF6F5F3"
                               FontFamily="Segoe UI" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Border x:Name="GripBar" Background="#59F6F5F3" CornerRadius="99"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Canvas x:Name="Board" HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</Window>

